# strsql-node environment variables
# Copy this file to .env and fill in your values.
# These are overridden by --flag options and take precedence over saved profiles.

STRSQL_HOST=192.168.1.100
STRSQL_USER=MYUSER
STRSQL_PASSWORD=MYPASSWORD
STRSQL_SCHEMA=MYLIB
STRSQL_ADAPTER=odbc
# Use STRSQL_ADAPTER=idb on IBM i/PASE to use IBM's native idb-connector.
