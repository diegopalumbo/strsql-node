{
  "name": "strsql-node",
  "version": "1.0.20",
  "description": "STRSQL session emulator for Node.js via ODBC and more",
  "main": "src/lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopalumbo/strsql-node.git"
  },
  "bin": {
    "strsql": "bin/strsql.js"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node bin/strsql.js",
    "test": "node test/run-tests.js",
    "test:unit": "node test/run-tests.js --unit",
    "test:cli": "node test/run-tests.js --cli",
    "release:publish": "npm publish --access public"
  },
  "keywords": [
    "ibm-i",
    "as400",
    "strsql",
    "odbc",
    "db2",
    "iseries"
  ],
  "license": "MIT",
  "author": "Diego Palumbo",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "odbc": "^2.4.9",
    "readline": "^1.3.0"
  },
  "optionalDependencies": {
    "idb-connector": "^1.2.19"
  }
}
